<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/insightsRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ps_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.insights.InsightsActivity">

    <!-- TOP APP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ps_back"
            android:contentDescription="Back"
            app:tint="@color/ps_text_primary"/>
        <TextView
            style="@style/PS.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Insights"/>
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ps_more_vert"
            app:tint="@color/ps_text_primary"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/insightsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO SECTION -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/ps_screen_padding">

                <LinearLayout
                    android:id="@+id/heroTextLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivHeroPet"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:id="@+id/tvHeroTitle"
                        style="@style/PS.Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="28sp"
                        tools:text="Personalized\ninsights for Max" />
                    <TextView
                        android:id="@+id/tvHeroSubtitle"
                        style="@style/PS.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="Golden Retriever • 2 Years" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivHeroPet"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/pet_insight"
                    android:scaleType="fitCenter"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- MAIN AI INSIGHT CARD -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/ps_surface">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/ps_bg_gradient_subtle"> <!-- Optional gradient if available, else standard surface -->
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_ps_sparkle"
                            app:tint="@color/ps_primary"/>
                        <TextView
                            style="@style/PS.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/ps_primary"
                            android:text="AI Insight"/>
                    </LinearLayout>
                    
                    <TextView
                        android:id="@+id/tvAiInsightText"
                        style="@style/PS.Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/ps_text_primary"
                        android:lineSpacingMultiplier="1.2"
                        tools:text="Max has been more active this week, with activity increasing during the evening."/>

                    <TextView
                        android:id="@+id/tvAiInsightContext"
                        style="@style/PS.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        tools:text="Based on recent activity, sleep and behavior data."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- THIS WEEK SECTION -->
            <TextView
                style="@style/PS.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="This Week"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <!-- Activity -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/PS.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🐾"
                                android:textSize="18sp"/>
                            <TextView
                                style="@style/PS.Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Activity"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvThisWeekActivityValue"
                            style="@style/PS.Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="22sp"
                            android:textColor="@color/ps_primary"
                            tools:text="+12%"/>
                        <TextView
                            android:id="@+id/tvThisWeekActivityDesc"
                            style="@style/PS.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="More active"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sleep -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/PS.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💤"
                                android:textSize="18sp"/>
                            <TextView
                                style="@style/PS.Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Sleep"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvThisWeekSleepValue"
                            style="@style/PS.Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="22sp"
                            android:textColor="@color/ps_pastel_blue_on"
                            tools:text="Stable"/>
                        <TextView
                            android:id="@+id/tvThisWeekSleepDesc"
                            style="@style/PS.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="Healthy pattern"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Behavior -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/PS.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="😊"
                                android:textSize="18sp"/>
                            <TextView
                                style="@style/PS.Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Behavior"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvThisWeekBehaviorValue"
                            style="@style/PS.Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="22sp"
                            android:textColor="@color/ps_pastel_peach_on"
                            tools:text="Mostly Calm"/>
                        <TextView
                            android:id="@+id/tvThisWeekBehaviorDesc"
                            style="@style/PS.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="4 of 7 days"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- PATTERN DETECTED -->
            <TextView
                style="@style/PS.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:text="Pattern Detected"/>

            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                app:cardCornerRadius="20dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <TextView
                        android:id="@+id/tvPatternTitle"
                        style="@style/PS.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ps_text_primary"
                        tools:text="🌙 Evening Activity"/>
                    
                    <TextView
                        android:id="@+id/tvPatternDesc"
                        style="@style/PS.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="Max is usually most active between 6 PM and 8 PM."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RECOMMENDATION CARD -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/ps_pastel_lavender">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_ps_lightbulb"
                            app:tint="@color/ps_primary"/>
                        <TextView
                            style="@style/PS.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/ps_primary"
                            android:text="Recommended for Max"/>
                    </LinearLayout>
                    
                    <TextView
                        android:id="@+id/tvRecommendation"
                        style="@style/PS.Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/ps_text_primary"
                        android:lineSpacingMultiplier="1.2"
                        tools:text="Try a short play session around his usual evening activity period."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ps_outline" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ps_surface"
        app:elevation="8dp"
        app:itemIconTint="@color/ps_bottom_nav_item"
        app:itemTextColor="@color/ps_bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu" />
</LinearLayout>
