<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ps_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:ignore="ContentDescription,HardcodedText">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================== HOME / DASHBOARD ===================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/dashboardScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ps_screen_padding"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/ps_screen_padding"
                android:paddingBottom="28dp">

                <!-- 1. TOP HEADER: menu · notification · avatar, then greeting + pet illustration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnMenu"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_pastel_circle"
                        android:backgroundTint="@color/ps_pastel_lavender"
                        android:contentDescription="@string/ps_cd_menu"
                        android:padding="11dp"
                        android:src="@drawable/ic_ps_menu"
                        app:tint="@color/ps_pastel_lavender_on"
                        tools:ignore="TouchTargetSizeCheck" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:id="@+id/tvGreeting"
                        style="@style/PS.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        app:layout_constraintEnd_toStartOf="@id/ivHeaderPetIllustration"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Welcome back, Sarah! 👋" />

                    <TextView
                        android:id="@+id/tvGreetingSubtitle"
                        style="@style/PS.Text.Display"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-black"
                        app:layout_constraintEnd_toStartOf="@id/ivHeaderPetIllustration"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvGreeting"
                        tools:text="How is Max doing today?" />

                    <!-- Swap this src for a real transparent pet PNG/WebP — see the note below the code. -->
                    <ImageView
                        android:id="@+id/ivHeaderPetIllustration"
                        android:layout_width="@dimen/ps_header_pet_illustration"
                        android:layout_height="@dimen/ps_header_pet_illustration"
                        android:contentDescription="@string/ps_cd_pet_illustration"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_pet_header_placeholder"
                        app:layout_constraintBottom_toBottomOf="@id/tvGreetingSubtitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvGreeting" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ===== NEW: COMPACT PET SELECTOR (multi-pet switching) =====
                     Purely additive: does not replace cardSelectedPet below, which still
                     opens the full Pet Profile exactly as before. This row's only job is
                     switching which pet is "active" on the dashboard. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPetSelector"
                        style="@style/PS.Card.Clickable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="@dimen/ps_pet_selector_radius">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/ps_pet_touch_target"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="8dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/ivPetSelectorAvatar"
                                android:layout_width="@dimen/ps_pet_selector_avatar"
                                android:layout_height="@dimen/ps_pet_selector_avatar"
                                android:background="@color/ps_primary_soft"
                                android:contentDescription="@string/ps_cd_pet_card_photo"
                                android:padding="4dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_ps_paw"
                                app:shapeAppearanceOverlay="@style/PS.ShapeAppearance.Circle" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvPetSelectorName"
                                    style="@style/PS.Text.Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:text="Max" />

                                <TextView
                                    android:id="@+id/tvPetSelectorMeta"
                                    style="@style/PS.Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:text="Dog · 2 Years" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_ps_dropdown"
                                app:tint="@color/ps_text_secondary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <ImageButton
                        android:id="@+id/btnAddPet"
                        android:layout_width="@dimen/ps_pet_touch_target"
                        android:layout_height="@dimen/ps_pet_touch_target"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_pastel_circle"
                        android:backgroundTint="@color/ps_pastel_green"
                        android:contentDescription="@string/ps_cd_add_pet"
                        android:padding="12dp"
                        android:src="@drawable/ic_ps_add"
                        app:tint="@color/ps_pastel_green_on" />
                </LinearLayout>

                <!-- 2. PET SUMMARY CARD: whole card is tappable -> Pet Profile -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSelectedPet"
                    style="@style/PS.Card.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/ps_primary_soft"
                    app:cardCornerRadius="@dimen/ps_card_radius_xl"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivPetAvatar"
                            android:layout_width="@dimen/ps_pet_card_avatar"
                            android:layout_height="@dimen/ps_pet_card_avatar"
                            android:background="@color/ps_surface"
                            android:contentDescription="@string/ps_cd_pet_card_photo"
                            android:padding="4dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_ps_paw"
                            app:shapeAppearanceOverlay="@style/PS.ShapeAppearance.Circle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvPetName"
                                    style="@style/PS.Text.Title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="Max" />

                                <ImageView
                                    android:id="@+id/ivPetGenderIcon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="4dp"
                                    android:contentDescription="Male"
                                    android:src="@drawable/ic_ps_gender_male"
                                    app:tint="@color/ps_pastel_blue_on" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvPetBreedAge"
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:letterSpacing="0.01"
                                android:text="Golden Retriever · 2 Years" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivPetCardChevron"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_ps_chevron"
                            app:tint="@color/ps_text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. QUICK ACTIONS: only features that exist elsewhere in the app -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuickActions"
                    style="@style/PS.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="@dimen/ps_card_radius_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="16dp">

                        <LinearLayout
                            android:id="@+id/actionHealthCheck"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/ps_quick_action_circle"
                                android:layout_height="@dimen/ps_quick_action_circle"
                                android:background="@drawable/bg_pastel_circle"
                                android:backgroundTint="@color/ps_pastel_green"
                                android:padding="14dp"
                                android:src="@drawable/ic_ps_health"
                                app:tint="@color/ps_pastel_green_on" />

                            <TextView
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="@string/ps_action_health_check" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/actionBehaviorAnalysis"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/ps_quick_action_circle"
                                android:layout_height="@dimen/ps_quick_action_circle"
                                android:background="@drawable/bg_pastel_circle"
                                android:backgroundTint="@color/ps_pastel_pink"
                                android:padding="14dp"
                                android:src="@drawable/ic_ps_behavior"
                                app:tint="@color/ps_pastel_pink_on" />

                            <TextView
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="@string/ps_action_behavior" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/actionActivity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/ps_quick_action_circle"
                                android:layout_height="@dimen/ps_quick_action_circle"
                                android:background="@drawable/bg_pastel_circle"
                                android:backgroundTint="@color/ps_pastel_peach"
                                android:padding="14dp"
                                android:src="@drawable/ic_ps_activity"
                                app:tint="@color/ps_pastel_peach_on" />

                            <TextView
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="@string/ps_action_activity" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/actionCareHistory"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/ps_quick_action_circle"
                                android:layout_height="@dimen/ps_quick_action_circle"
                                android:background="@drawable/bg_pastel_circle"
                                android:backgroundTint="@color/ps_pastel_blue"
                                android:padding="14dp"
                                android:src="@drawable/ic_ps_care_history"
                                app:tint="@color/ps_pastel_blue_on" />

                            <TextView
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="@string/ps_action_care_history" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/actionProfileHelp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/ps_quick_action_circle"
                                android:layout_height="@dimen/ps_quick_action_circle"
                                android:background="@drawable/bg_pastel_circle"
                                android:backgroundTint="@color/ps_pastel_lavender"
                                android:padding="14dp"
                                android:src="@drawable/ic_ps_help"
                                app:tint="@color/ps_pastel_lavender_on" />

                            <TextView
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="@string/ps_action_profile_help" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. TODAY AT A GLANCE -->
                <TextView
                    style="@style/PS.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ps_section_gap"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:text="@string/ps_section_glance" />

                <!-- 5. HEALTH SCORE METER — dominant card, real custom View, not an image -->
                <!-- 5. HEALTH SCORE METER — FrameLayout allows text to float on top of the meter -->
                <!-- 5. ENHANCED HEALTH SCORE METER -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHealthScore"
                    style="@style/PS.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/ps_card_radius_lg">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp">

                        <!-- The Custom Gauge -->
                        <com.example.pet.ui.dashboard.HealthScoreView
                            android:id="@+id/healthScoreView"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ps_gauge_height"
                            android:contentDescription="@string/ps_cd_health_score"
                            app:gaugeStrokeWidth="@dimen/ps_gauge_stroke_width"
                            app:maxScore="100"
                            app:score="86" />

                        <!-- Enhanced text overlays -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp">

                            <!-- Subtle Label -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:background="@drawable/bg_camera_placeholder"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.05"
                                android:text="HEALTH SCORE"
                                android:textAllCaps="true"
                                android:textColor="@color/ps_text_primary"
                                android:textSize="12sp" />

                            <!-- Score Value -->
                            <TextView
                                android:id="@+id/tvHealthScoreValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="86"
                                android:textColor="@color/ps_text_primary"
                                android:textSize="48sp"
                                android:includeFontPadding="false" />

                            <!-- High-Visibility Status Pill -->
                            <TextView
                                android:id="@+id/tvHealthScoreStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_status_pill"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="4dp"
                                android:text="@string/ps_health_score_status_good"
                                android:textColor="@color/ps_pastel_green_on"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sleep / Activity / Feeding / Water — compact 2x2 grid, easy to scan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileSleep"
                        style="@style/PS.Card.Tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <ImageView
                                style="@style/PS.IconBubble"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:padding="9dp"
                                android:src="@drawable/ic_ps_sleep" />

                            <TextView
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:letterSpacing="0.01"
                                android:text="@string/ps_glance_sleep" />

                            <TextView
                                android:id="@+id/tvSleepValue"
                                style="@style/PS.Text.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:fontFeatureSettings="tnum"
                                android:text="@string/ps_glance_sleep_value" />

                            <TextView
                                android:id="@+id/tvSleepStatus"
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ps_glance_sleep_status" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileActivity"
                        style="@style/PS.Card.Tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <ImageView
                                style="@style/PS.IconBubble"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:padding="9dp"
                                android:src="@drawable/ic_ps_activity" />

                            <TextView
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:letterSpacing="0.01"
                                android:text="@string/ps_glance_activity" />

                            <TextView
                                android:id="@+id/tvActivityValue"
                                style="@style/PS.Text.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:fontFeatureSettings="tnum"
                                android:text="@string/ps_glance_activity_value" />

                            <TextView
                                android:id="@+id/tvActivityStatus"
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ps_glance_activity_status" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileFeeding"
                        style="@style/PS.Card.Tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <ImageView
                                style="@style/PS.IconBubble"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:padding="9dp"
                                android:src="@drawable/ic_ps_nutrition" />

                            <TextView
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:letterSpacing="0.01"
                                android:text="@string/ps_glance_feeding" />

                            <TextView
                                android:id="@+id/tvFeedingValue"
                                style="@style/PS.Text.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:fontFeatureSettings="tnum"
                                android:text="@string/ps_glance_feeding_value" />

                            <TextView
                                android:id="@+id/tvFeedingStatus"
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ps_glance_feeding_status" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileWater"
                        style="@style/PS.Card.Tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <ImageView
                                style="@style/PS.IconBubble"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:padding="9dp"
                                android:src="@drawable/ic_ps_water" />

                            <TextView
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:letterSpacing="0.01"
                                android:text="@string/ps_glance_water" />

                            <TextView
                                android:id="@+id/tvWaterValue"
                                style="@style/PS.Text.Value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:fontFeatureSettings="tnum"
                                android:text="@string/ps_glance_water_value" />

                            <TextView
                                android:id="@+id/tvWaterStatus"
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ps_glance_water_status" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- 7. OPTIONAL LOW-PRIORITY CARD: reuses your existing preventive-care feature,
                     not a new/fake one — kept small and below the fold on purpose. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPreventive"
                    style="@style/PS.Card.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/ps_pastel_peach"
                    app:cardCornerRadius="@dimen/ps_card_radius_lg"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_pastel_circle"
                            android:backgroundTint="@color/ps_surface"
                            android:padding="10dp"
                            android:src="@drawable/ic_ps_shield"
                            app:tint="@color/ps_pastel_peach_on" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPreventiveTitle"
                                style="@style/PS.Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/ps_care_reminder_title" />

                            <TextView
                                android:id="@+id/tvPreventiveDetail"
                                style="@style/PS.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:letterSpacing="0.01"
                                android:text="@string/ps_care_reminder_detail" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnViewCareSchedule"
                            style="@style/PS.Text.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackground"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingHorizontal="4dp"
                            android:text="@string/ps_view_schedule"
                            android:textColor="@color/ps_pastel_peach_on"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===================== TAB PLACEHOLDER (unchanged) ===================== -->
        <LinearLayout
            android:id="@+id/placeholderContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivPlaceholderIcon"
                style="@style/PS.IconBubble"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="16dp"
                android:src="@drawable/ic_ps_health" />

            <TextView
                android:id="@+id/tvPlaceholderTitle"
                style="@style/PS.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Health" />

            <TextView
                android:id="@+id/tvPlaceholderSubtitle"
                style="@style/PS.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:text="This screen is coming soon." />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== BOTTOM NAVIGATION (unchanged) ===================== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ps_outline" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ps_surface"
        app:elevation="8dp"
        app:itemIconTint="@color/ps_bottom_nav_item"
        app:itemTextColor="@color/ps_bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu" />
</LinearLayout>